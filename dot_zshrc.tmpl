{{- template "shell/common.sh" . }}

if command -v brew >/dev/null 2>&1; then
  FPATH="$(brew --prefix)/share/zsh/site-functions:${FPATH}"
  autoload -Uz compinit
  compinit
fi

if command -v kubectl >/dev/null 2>&1; then
  source <(kubectl completion zsh)
fi

if command -v az >/dev/null 2>&1 && command -v brew >/dev/null 2>&1; then
  az_completion="$(brew --prefix)/etc/bash_completion.d/az"
  [[ -r "$az_completion" ]] && source "$az_completion"
fi

export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git kubectl kubectx helm)
[[ -r "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

[[ -r "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"

if command -v gh >/dev/null 2>&1; then
  eval "$(gh copilot alias -- zsh)"
fi

export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"
