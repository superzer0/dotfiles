# brew autocomplete for zsh
if type brew &>/dev/null
then
  FPATH="$(brew --prefix)/share/zsh/site-functions:${FPATH}"
  autoload -Uz compinit
  compinit
  autoload -U +X bashcompinit && bashcompinit
fi

#kubectl autocomplete
if (( $+commands[kubectl] )); then
  source <(kubectl completion zsh)
fi

# AZ autocomplete
_az_completion="$(brew --prefix)/etc/bash_completion.d/az"
[[ -r $_az_completion ]] && source $_az_completion
unset _az_completion

# NOTE: plugins=() and ZSH_THEME= must be set BEFORE `source $ZSH/oh-my-zsh.sh`.
# This file is sourced at the END of ~/.zshrc (see MANUAL STEPS below), so both
# are too late to take effect here — set them in ~/.zshrc itself. Kept for
# reference only:
#   plugins=(git kubectl kubectx helm)
#   ZSH_THEME="powerlevel10k/powerlevel10k"

# -- Powerlevel10k --
# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# gh copilot alias — only eval what the command actually produced.
#
# Probing with `gh copilot --version` is not enough. When the standalone GitHub
# Copilot CLI (Homebrew `copilot`) is on PATH, `gh copilot` forwards to it:
# `--version` succeeds, but that CLI has no `alias` subcommand, so
# `gh copilot alias -- zsh` prints a usage error to stderr, writes nothing to
# stdout — and still exits 0. Testing the exit status would pass and the eval
# would spray that error into every new shell.
#
# Capturing stdout with stderr discarded is the reliable test: empty means there
# is nothing to eval, whichever copilot implementation answered.
if (( $+commands[gh] )); then
  _gh_copilot_alias=$(gh copilot alias -- zsh 2>/dev/null)
  [[ -n $_gh_copilot_alias ]] && eval "$_gh_copilot_alias"
  unset _gh_copilot_alias
fi

export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"

alias ls="lsd -alh --color=auto"
alias l="lsd -lh --color=auto"

#Other:
alias listening="lsof -i -P | grep -i 'listen'"

# -- Git --
alias g="git"
alias gpr="git pull --rebase"
alias gforce="git push --force-with-lease"

# -- Containers --
alias d="docker"
alias k="kubectl"
# Kubectl edit command will use this env var.
export EDITOR='code --wait'
# Should your editor deal with streamed vs on disk files differently, also set...
export K9S_EDITOR='code --wait'



# -- MANUAL STEPS --
## In ~/.zshrc, in THIS order — the first two must precede oh-my-zsh:
#   eval "$(/opt/homebrew/bin/brew shellenv)"   # brew on PATH; this file calls `brew --prefix`
#   ZSH_THEME="powerlevel10k/powerlevel10k"
#   plugins=(git kubectl kubectx helm)
#   source $ZSH/oh-my-zsh.sh
#   export CLAUDE_REPO_ROOT="$HOME/repo"
#   source ~/repo/dotfiles/.zshrc_osx
#
# Download iTerm Materials theme from inside this zsh theme:
# https://github.com/carloscuesta/materialshell/tree/master/shell-color-themes#iterm
# Install oh-my-zsh
# https://ohmyz.sh/#install
# Install ZSH theme git clone --depth=1 https://github.com/romkatv/powerlevel10k.git
# https://github.com/romkatv/powerlevel10k#installation
# set ZSH_THEME="powerlevel10k/powerlevel10k" in .zshrc
# link ~/repo/dotfiles/.pk10k.zsh ~/.pk10k.zsh
# install fonts: https://github.com/romkatv/powerlevel10k?tab=readme-ov-file#meslo-nerd-font-patched-for-powerlevel10k

